{
  "annotations": {
    "list": []
  },
  "description": "Dashboard integral de observabilidad, rendimiento y metricas CI/CD - Sistema de Gestion de Incidencias (DOY0101 EP3)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Disponibilidad de Microservicios (IE1)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "title": "Estado Backend (Spring Boot)",
      "type": "stat",
      "targets": [{ "expr": "max(up{job=~\".*backend\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "title": "Estado Frontend (Nginx)",
      "type": "stat",
      "targets": [{ "expr": "max(up{job=~\".*frontend\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Estado Base de Datos (MySQL)",
      "type": "stat",
      "targets": [{ "expr": "max(up{job=~\".*mysql.*\"})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "Uptime Backend",
      "type": "stat",
      "targets": [{ "expr": "max(process_uptime_seconds{job=~\".*backend\"})", "refId": "A" }]
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Metricas Clave de CI/CD y Calidad (IE3 & IE5)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 180 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 6 },
      "id": 5,
      "title": "Tiempo de Despliegue CI/CD",
      "type": "stat",
      "targets": [{ "expr": "max(cicd_deploy_duration_seconds)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 6 },
      "id": 6,
      "title": "Cobertura de Pruebas (JaCoCo)",
      "type": "gauge",
      "targets": [{ "expr": "max(cicd_test_coverage_percent)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 6 },
      "id": 7,
      "title": "Vulnerabilidades Criticas/Altas",
      "type": "stat",
      "targets": [{ "expr": "max(cicd_security_vulnerabilities_total)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "BLOQUEADO" }, "1": { "color": "green", "text": "APROBADO" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 6 },
      "id": 8,
      "title": "Estado Quality Gate CI/CD",
      "type": "stat",
      "targets": [{ "expr": "max(cicd_pipeline_status)", "refId": "A" }]
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 102,
      "title": "Uso de Recursos (CPU / Memoria) y Errores Registrados (IE1 & IE3)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "id": 9,
      "title": "Uso de CPU del Microservicio Backend",
      "type": "timeseries",
      "targets": [
        { "expr": "process_cpu_usage{job=~\".*backend\"}", "legendFormat": "CPU Proceso", "refId": "A" },
        { "expr": "system_cpu_usage{job=~\".*backend\"}", "legendFormat": "CPU Sistema", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "id": 10,
      "title": "Uso de Memoria JVM (Heap vs Max)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=~\".*backend\", area=\"heap\"})", "legendFormat": "Heap Usado", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{job=~\".*backend\", area=\"heap\"})", "legendFormat": "Heap Maximo", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "id": 11,
      "title": "Solicitudes HTTP y Errores Registrados (4xx / 5xx)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=~\".*backend\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A" },
        { "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*backend\", status=~\"5..\"}[5m]))", "legendFormat": "Errores 5xx", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "id": 12,
      "title": "Conexiones Activas Nginx (Frontend) y Threads JVM",
      "type": "timeseries",
      "targets": [
        { "expr": "nginx_connections_active{job=~\".*frontend\"}", "legendFormat": "Conexiones Nginx", "refId": "A" },
        { "expr": "jvm_threads_live_threads{job=~\".*backend\"}", "legendFormat": "JVM Live Threads", "refId": "B" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["devops", "incidencias", "observabilidad", "cicd", "ep3"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Sistema de Incidencias - Observabilidad & CI/CD (EP3)",
  "uid": "incidencias-devops-ep3",
  "version": 2
}
