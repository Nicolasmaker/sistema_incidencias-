# PLANTILLA DE SECRETOS KUBERNETES (NO commitear valores reales en Git - IE5)
# En CI/CD se crea automaticamente via kubectl create secret desde GitHub Secrets.
apiVersion: v1
kind: Secret
metadata:
  name: incidencias-secrets
  namespace: incidencias
type: Opaque
stringData:
  MYSQL_USER: "REEMPLAZAR_USUARIO"
  MYSQL_PASSWORD: "REEMPLAZAR_PASSWORD"
  MYSQL_ROOT_PASSWORD: "REEMPLAZAR_ROOT_PASSWORD"
  MYSQL_EXPORTER_DSN: "REEMPLAZAR_USUARIO:REEMPLAZAR_PASSWORD@(localhost:3306)/"
